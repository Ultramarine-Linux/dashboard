{
	"name": "ultramarine-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
		"build": "vite build",
		"preview": "node build",
		"test:unit": "vitest run",
		"test:accessibility": "node tests/run-accessibility-brands.mjs",
		"test:accessibility:ultramarine": "playwright test",
		"test:accessibility:ci": "playwright install --with-deps chrome && pnpm run test:accessibility",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"i18n:check": "node scripts/i18n-check.mjs",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "pnpm dlx @better-auth/cli@1.4.22 generate --config auth.config.ts --output src/lib/server/db/auth.schema.ts --yes",
		"backport:dashboard:status": "node scripts/backport-dashboard.mjs status",
		"backport:dashboard:plan": "node scripts/backport-dashboard.mjs plan",
		"backport:dashboard:plan-since-fork": "node scripts/backport-dashboard.mjs plan-since-fork",
		"backport:dashboard:apply": "node scripts/backport-dashboard.mjs apply",
		"backport:dashboard:apply-since-fork": "node scripts/backport-dashboard.mjs apply-since-fork"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@better-auth/cli": "^1.4.22",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/lucide": "^1.2.147",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@types/qrcode": "^1.5.6",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"better-auth": "~1.6.33",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@better-auth/core": "~1.6.33",
		"@better-auth/telemetry": "~1.6.33",
		"@better-auth/utils": "^0.5.0",
		"@lucide/svelte": "^1.61.0",
		"@plausible-analytics/tracker": "^0.4.6",
		"arktype": "^2.2.9",
		"better-sqlite3": "^13.0.3",
		"i18nya": "^0.2.6",
		"ip-address": "^10.7.4",
		"ky": "^2.2.0",
		"qrcode": "^1.5.4",
		"ulid": "^3.0.2",
		"undici": "^8.12.3",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
