# Production image of Ultramarine Server Dashboard.
#
# Build from the repository root (the pnpm workspace):
#
#   podman build -f apps/dashboard/Containerfile -t dashboard .
#
# Every stage runs on the target architecture, so better-sqlite3 is installed
# (its bundled prebuilt binary, or a build from source) for it here; nothing
# built on the host is copied in (see .dockerignore).
# Build each architecture on a native runner, or under emulation with
# --platform.

ARG NODE_MAJOR=24
# The runtime is distroless Debian 13, so the build stage uses Debian 13 too:
# the native module must link against the same glibc.
ARG BUILD_IMAGE=docker.io/library/node:${NODE_MAJOR}-trixie-slim
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs${NODE_MAJOR}-debian13:nonroot

FROM ${BUILD_IMAGE} AS build

# Toolchain for node-gyp: pnpm runs better-sqlite3's node-gyp step, which
# uses the bundled prebuilt binary for linux-x64/arm64 and builds SQLite from
# source only without one. node-gyp needs these either way.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /src
ENV CI=true

# pnpm at the version pinned by packageManager.
COPY package.json ./
RUN npm install --global "$(node -p 'require("./package.json").packageManager')"

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/dashboard/package.json apps/dashboard/package.json
RUN pnpm install --frozen-lockfile --filter ultramarine-dashboard...

COPY apps/dashboard apps/dashboard
RUN pnpm --filter ultramarine-dashboard build

# Production dependencies only (the adapter-node bundle keeps `dependencies`
# external), installed for this architecture. Load better-sqlite3 to be sure.
RUN pnpm --filter ultramarine-dashboard deploy --prod --legacy /out \
	&& node -e "new (require('/out/node_modules/better-sqlite3'))(':memory:').prepare('select 1').get()"

# The state directory, for runs without a volume. The Quadlet mounts the host's
# /var/lib/ultramarine-dashboard over it. Dashboard refuses a state directory
# others can read, and COPY only keeps the mode of entries inside the copied
# directory, so copy its parent.
RUN mkdir -p /state/ultramarine-dashboard \
	&& chmod 700 /state/ultramarine-dashboard \
	&& chown 65532:65532 /state/ultramarine-dashboard

FROM ${RUNTIME_IMAGE}

# For local builds. The Image workflow's build replaces these with labels
# docker/metadata-action derives from the repository.
LABEL org.opencontainers.image.title="Ultramarine Server Dashboard" \
	org.opencontainers.image.description="Web dashboard for Ultramarine Server" \
	org.opencontainers.image.source="https://github.com/Ultramarine-Linux/dashboard" \
	org.opencontainers.image.url="https://ultramarine-linux.org/" \
	org.opencontainers.image.vendor="Fyra Labs" \
	org.opencontainers.image.licenses="AGPL-3.0-or-later"

WORKDIR /app
COPY --from=build /out/package.json ./package.json
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /src/apps/dashboard/build ./build
COPY --from=build /src/apps/dashboard/serve.js ./serve.js
# Dashboard applies these on startup and /health checks them.
COPY --from=build /src/apps/dashboard/drizzle ./drizzle
COPY --from=build --chown=65532:65532 /state/ /var/lib/

# Listen on every interface inside the container so the published port works.
# The Quadlet publishes it on the host's 127.0.0.1:3972 only, behind Caddy.
# On SIGTERM adapter-node waits up to SHUTDOWN_TIMEOUT seconds for requests in
# flight (30 by default), then Dashboard closes its Tetra connection. Keep the
# total well under Podman's 10-second stop timeout.
# Without ORIGIN, adapter-node takes the scheme from X-Forwarded-Proto, which
# Caddy sets (and strips from clients); otherwise it assumes https, and a page
# served over plain http would fail SvelteKit's CSRF check on every form post.
ENV NODE_ENV=production \
	HOST=0.0.0.0 \
	PROTOCOL_HEADER=x-forwarded-proto \
	PORT=3972 \
	SHUTDOWN_TIMEOUT=5 \
	UM_DASHBOARD_STATE_DIR=/var/lib/ultramarine-dashboard
EXPOSE 3972

# Distroless :nonroot runs as 65532. The Quadlet overrides it with the host
# UID of ultramarine-dashboard, which Tetra identifies on its socket; the
# files above are world-readable, so any UID can run them.
USER 65532:65532
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["serve.js"]
